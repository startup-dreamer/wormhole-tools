{
  "name": "@wormcraft/sdk",
  "version": "0.0.4",
  "description": "TypeScript SDK for Wormhole cross-chain protocol interactions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startup-dreamer/wormhole-tools.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/startup-dreamer/wormhole-tools/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/startup-dreamer/wormhole-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@solana/web3.js": "^1.95.0",
    "viem": "^2.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
