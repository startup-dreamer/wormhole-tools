{
  "name": "wormcraft",
  "version": "0.0.3",
  "description": "CLI tool for Wormhole cross-chain protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startup-dreamer/wormhole-tools.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/startup-dreamer/wormhole-tools/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/startup-dreamer/wormhole-tools/issues"
  },
  "type": "module",
  "bin": {
    "wormcraft": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@wormcraft/sdk": "^0.0.3",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
